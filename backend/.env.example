PORT=3000
# استخدم اتصال Supabase (Transaction pooler للـ serverless / Session pooler للسيرفر التقليدي):
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# بدائل فردية للاتصال المحلي (اختياري إذا لم تُحدّد DATABASE_URL):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

# ===== مصادقة الداشبورد (Login Gate) =====
# كلمة السر المشتركة (عميل واحد فقط) مخزنة كـ هاش bcrypt (ممنوع النص الصريح).
# ولّد الهاش محليًا من كلمة السر بلي تعبّر فيها (ماشي كلمة السر بحد ذاتها):
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# ثم ضع الناتج هنا. كلمة السر الحقيقية ما تكونش فـ git ولا فـ أي ملف فالمشروع.
DASHBOARD_PASSWORD_HASH=
# سر توقيع JWT — نص عشوائي طويل، ولّده مرة وحدة:
#   openssl rand -hex 32
JWT_SECRET=
# مدة صلاحية التوكن (7 أيام افتراضيًا):
JWT_EXPIRES_IN=7d

# أصل (origin) الواجهة المنشورة فقط — Netlify URL. ممنوع '*' في الإنتاج.
FRONTEND_URL=
# مفتاح API ثابت — مخصص للاستعمال البرمجي فقط (سكريبتات خارجية)،
# ماشي للداشبورد. ولّده بـ: openssl rand -hex 32
DASHBOARD_API_KEY=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_API_VERSION=v21.0

# ===== Google Sheets (صفحة الطلبات Orders) — OAuth2 =====
# نفس مبدأ credential "Google Sheets account" في n8n: تطبيق OAuth بدل Service Account.
# 1) أنشئ OAuth Client في Google Cloud Console > APIs & Services > Credentials
#    ثم فعّل "Google Sheets API". أضف في Authorized redirect URIs:
#       http://127.0.0.1:3010/oauth2callback
#    وإن كان تطبيقك في وضع "Testing" أضف حسابك لقائمة Test users.
# 2) املأ GOOGLE_CLIENT_ID و GOOGLE_CLIENT_SECRET، ثم شغّل:
#       node scripts/google-oauth.js
#    ليفتح لك شاشة الموافقة ويكتب GOOGLE_REFRESH_TOKEN تلقائيًا في .env.
#    الصلاحية المطلوبة الآن read + write (لتحديث حالة الطلبيات) —
#    لذا إن كان توكنك قديمًا من نسخة "readonly" فأعد تشغيل السكريبت مرة أخرى.
# 3) الحساب المرتبط بالتوكن يجب أن يرى الشيت (شارك الشيت معه كـ Viewer على الأقل).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# معرف الشيت (قابل للتغيير من الـ env، الافتراضي شيت الطلبات الحالي):
GOOGLE_SHEET_ID=1gMyGL5mfDLUdTC4szOkuzycNENKuk-HARsatmG_lGrU
# اسم تبويب الطلبات داخل الشيت (التبويب الفعلي حالياً: ORDER):
GOOGLE_SHEET_TAB=ORDER